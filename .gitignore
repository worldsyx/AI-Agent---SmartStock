# ==========================================
# Root .gitignore - SmartStock PRO
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.env
auth.json
*.key
*credential*
*secret*

# Databases & local storage
database.sqlite
database.sqlite-journal
*.sqlite
*.sqlite3
*.db
backend/database/database.sqlite*

# Node / Frontend dependencies & build artifacts
node_modules/
*/node_modules/
dist/
dist-ssr/
frontend/dist/
frontend/node_modules/
.vite/
*.local

# PHP / Laravel dependencies & generated files
vendor/
backend/vendor/
composer.phar
backend/public/build/
backend/public/hot/
backend/public/storage/
backend/storage/*.key
backend/storage/pail/
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
!backend/storage/framework/cache/data/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/testing/.gitignore
!backend/storage/framework/views/.gitignore
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore

# Python / AI Service
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
ai-service/__pycache__/
ai-service/venv/
ai-service/.venv/

# Logs & temporary files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor generated files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
