{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai-service": {
      "root": "ai-service",
      "framework": "flask"
    },
    "backend": {
      "root": "backend",
      "framework": "vite"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
